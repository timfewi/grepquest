---
import TerminalCapture from "./TerminalCapture.astro";
---

<section class="section product-proof" aria-labelledby="proof-title">
  <div class="page-shell">
    <div class="section-heading proof-heading">
      <p class="eyebrow">PRODUCT EVIDENCE · CORE V1</p>
      <h2 id="proof-title">A game you play<br />with real tools.</h2>
      <p>
        No toy syntax. No multiple choice. The commands you learn here are the commands you can use in logs,
        repositories, and production systems.
      </p>
    </div>

    <div class="proof-stage">
      <div class="proof-terminal"><TerminalCapture mode="proof" /></div>
      <ol class="proof-callouts" aria-label="GrepQuest interface regions">
        <li><span>01</span><div><strong>Mission</strong><p>Objective, file context, tags, and room danger.</p></div></li>
        <li><span>02</span><div><strong>Terminal</strong><p>Real command input, matched lines, and useful feedback.</p></div></li>
        <li><span>03</span><div><strong>Ranger</strong><p>Level, mastery, and five explicit equipment slots.</p></div></li>
      </ol>
    </div>
  </div>
</section>
